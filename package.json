    "expo": "58.0.23",
    "expo-dev-client": "58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "hotcodepush": "0.3.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
