{
  "name": "expo-ota-updates-demo",
  "version": "0.0.0",
  "private": true,
  "description": "The HotCodePush Expo OTA updates demo app",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "fmt": "prettier --write .",
    "ios": "expo run:ios",
